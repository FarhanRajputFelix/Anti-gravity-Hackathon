# SAHARA AI Backend Environment Variables
# Copy to .env and fill in your keys. Loaded via python-dotenv on startup.

# Google Gemini API Key — enables AI-enhanced agent reasoning.
# Get one at: https://aistudio.google.com/apikey
# If unset or default, the orchestrator falls back to rule-based reasoning.
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name. Defaults to "gemini-flash-latest" which auto-tracks the
# current Flash model. Override if you need a specific snapshot
# (e.g. gemini-2.5-flash, gemini-2.5-pro). gemini-1.5-flash is deprecated.
GEMINI_MODEL=gemini-flash-latest

# WeatherAPI.com — real weather verification in agents/verification.py.
# Get a free key at: https://www.weatherapi.com/signup.aspx
# If unset, verification falls back to historical/mock baselines.
WEATHERAPI_KEY=your-weatherapi-key-here

# Geoapify Maps — tile renderer for the Flutter map screen.
# Get a free key at: https://myprojects.geoapify.com/
# NOTE: Flutter does NOT read this file at runtime. Pass the key in via:
#   flutter run -d chrome --dart-define=GEOAPIFY_KEY=<your-key>
# This entry exists so all three keys live in one place for the team.
GEOAPIFY_KEY=your-geoapify-key-here

# Optional: Firebase Realtime DB persistence (defaults to in-memory store).
# FIREBASE_ENABLED=true
# FIREBASE_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_DB_URL=https://your-project.firebaseio.com
